<!DOCTYPE html>
<html lang="{{ site.language }}">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <script>document.documentElement.classList.add("has-nav-js")</script>
  <title>{% if title %}{{ title }} — {{ site.name }}{% else %}{{ site.title }}{% endif %}</title>
{%- if description %}
  <meta name="description" content="{{ description }}" />
{%- endif %}
{%- if noindex %}
  <meta name="robots" content="noindex" />
{%- endif %}
  <link rel="preload" as="font" type="font/woff2" href="/fonts/cormorant-garamond-latin-500-normal.woff2" crossorigin />
  <link rel="preload" as="font" type="font/woff2" href="/fonts/outfit-latin-400-normal.woff2" crossorigin />
  <link rel="stylesheet" href="/css/fonts.css?v={{ site.assetVersion }}" />
{%- include "partials/head-meta.njk" %}
  <link rel="alternate" type="application/rss+xml" title="{{ site.blog.title }}" href="/blog/rss.xml" />
{%- block headPre %}{% endblock %}
  <link rel="stylesheet" href="/css/styles.css?v={{ site.assetVersion }}" />
  <link rel="stylesheet" href="/css/components.css?v={{ site.assetVersion }}" />
{%- if extraCss %}
  <link rel="stylesheet" href="/css/{{ extraCss }}?v={{ site.assetVersion }}" />
{%- endif %}
{%- block head %}{% endblock %}
  <link rel="icon" href="{{ site.favicon | safe }}" />
{%- block headEnd %}
{%- if isHome %}
{% include "partials/jsonld-home.njk" %}
{%- elif not noindex and not book %}
{% include "partials/jsonld-breadcrumbs.njk" %}
{%- endif %}
{%- endblock %}
</head>
<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
  <a class="skip-link" href="#{{ skipTarget or 'main' }}">{{ skipLabel or 'Skip to content' }}</a>
{% include "partials/nav.njk" %}
{% block main %}{{ content | safe }}{% endblock %}
{% include "partials/footer.njk" %}
{%- block scripts %}{% endblock %}
{%- if not noAnalytics %}
  <script src="/js/analytics.js?v={{ site.assetVersion }}" defer></script>
{%- endif %}
  <script src="/js/nav.js?v={{ site.assetVersion }}" defer></script>
{%- if needsRail %}
  <script src="/js/rail.js?v={{ site.assetVersion }}" defer></script>
{%- endif %}
{%- if needsReveal %}
  <script src="/js/reveal.js?v={{ site.assetVersion }}" defer></script>
{%- endif %}
</body>
</html>
