{#- Author intro (#about): author.bioLong verbatim; monogram until author.headshot is set (never a stock photo). -#}
{%- set ab = homeCopy.about -%}
{%- if author.bioLong and author.bioLong.length %}
    <section class="home-section container about-home" id="about" aria-labelledby="about-title">
      <div class="section-head section-head--rule about-home__rule"></div>
      <div class="about-home__grid">
        <div class="about-home__media reveal">
{%- if author.headshot and author.headshot.src %}
          <figure class="headshot">
            <picture>
              <source type="image/webp" srcset="/media/author/courtney-thomas-480.webp 480w, /media/author/courtney-thomas.webp 960w" sizes="(min-width: 900px) 360px, 70vw" />
              <img src="{{ author.headshot.src }}" srcset="{{ author.headshot.srcset }}" sizes="(min-width: 900px) 360px, 70vw" alt="{{ author.headshot.alt }}" width="{{ author.headshot.width }}" height="{{ author.headshot.height }}" loading="lazy" decoding="async" />
            </picture>
{%- if author.headshot.credit %}
            <figcaption class="headshot__credit">{{ author.headshot.credit }}</figcaption>
{%- endif %}
          </figure>
{%- else %}
          <div class="monogram" aria-hidden="true">CT</div>
{%- endif %}
        </div>
        <div class="about-home__text reveal">
          <p class="eyebrow">{{ ab.eyebrow }}</p>
          <h2 id="about-title">{{ ab.heading }}</h2>
{%- for p in author.bioLong %}
          <p>{{ p | safe }}</p>
{%- endfor %}
          <a class="btn btn--quiet btn--small" href="/#about">{{ ab.moreLink }} <span aria-hidden="true">→</span></a>
{%- if author.honor and author.honor.title %}
          <aside class="honor" aria-labelledby="honor-title">
            <img class="honor__seal" src="{{ author.honor.seal.src }}" srcset="{{ author.honor.seal.srcset }}" width="96" height="96" alt="{{ author.honor.seal.alt }}" loading="lazy" decoding="async" />
            <div class="honor__body">
              <p class="eyebrow">{{ author.honor.eyebrow }}</p>
              <p class="honor__title" id="honor-title">{{ author.honor.title }}</p>
              <p class="honor__text">{{ author.honor.body }}</p>
              <a class="btn btn--primary btn--small" href="/books/{{ author.honor.bookSlug }}.html">{{ author.honor.cta }}</a>
            </div>
          </aside>
{%- endif %}
        </div>
      </div>
    </section>
{%- endif %}
