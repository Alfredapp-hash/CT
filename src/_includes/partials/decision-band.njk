{#- Decision band: first child of <main id="library">, directly after the preserved hero.
    Status / hook / CTAs come only from site.featured (defaults copied from homeCopy.hero);
    copy for eyebrow, name, positioning, aria labels from homeCopy.hero; facts from books.json. -#}
{%- from "partials/cover.njk" import cover -%}
{%- set fx = site.featured -%}
{%- set featuredBook = books | bookBySlug(fx.slug) -%}
    <section class="hero-band container" aria-labelledby="hero-band-title">
{%- if featuredBook %}
      <a class="hero-band__cover" href="/books/{{ featuredBook.slug }}.html">
        <figure class="jacket">
          {{ cover(featuredBook, { eager: true, priority: "low" }) }}
        </figure>
      </a>
{%- endif %}
      <div class="hero-band__text">
        <p class="eyebrow hero-band__eyebrow">{{ homeCopy.hero.eyebrow }}</p>
        <h1 class="hero-band__title" id="hero-band-title"><span class="visually-hidden">{{ homeCopy.hero.name }}. </span>{{ homeCopy.hero.positioning }}</h1>
{%- if featuredBook %}
{%- if featuredBook.awards and featuredBook.awards.length %}
        <p class="hero-band__award">
          <img src="{{ featuredBook.awards[0].seal.src }}" srcset="{{ featuredBook.awards[0].seal.srcset }}" width="64" height="64" alt="{{ featuredBook.awards[0].seal.alt }}" decoding="async" />
          <span><strong>{{ featuredBook.awards[0].honor }}</strong><br>{{ featuredBook.awards[0].name }} · {{ featuredBook.awards[0].category }} · {{ featuredBook.awards[0].year }}</span>
        </p>
{%- elif fx.statusPill %}
        <p class="hero-band__pill"><span class="pill pill--outline">{{ fx.statusPill }}</span></p>
{%- endif %}
{%- if fx.hook %}
        <p class="hero-band__hook">{{ fx.hook }}</p>
{%- endif %}
        <div class="hero-band__actions">
          <a class="btn btn--primary" href="/books/{{ featuredBook.slug }}.html#buy">{{ fx.ctaPrimary }}<span class="visually-hidden">: {{ featuredBook.title }}</span></a>
          <a class="btn btn--secondary" href="/#books">{{ fx.ctaSecondary }}</a>
        </div>
{%- else %}
        <div class="hero-band__actions">
          <a class="btn btn--secondary" href="/#books">{{ fx.ctaSecondary }}</a>
        </div>
{%- endif %}
        <p class="hero-band__trust">{{ site.distribution }}</p>
      </div>
    </section>
