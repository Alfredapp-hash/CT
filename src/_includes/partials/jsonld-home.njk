{#- Home page JSON-LD: one @graph with Person (sameAs only from non-null site.social), WebSite and an ItemList of every book.
    Facts only from site.json / author.json / books.json. -#}
{%- set sameAs = [] -%}
{%- for key, href in site.social %}{% if href %}{% set sameAs = (sameAs.push(href), sameAs) %}{% endif %}{% endfor -%}
{%- set person = {
  "@type": "Person",
  "@id": (site.url + "/#person"),
  "name": author.name,
  "url": ("/" | absoluteUrl(site.url)),
  "jobTitle": "Author",
  "description": site.ogDescription
} -%}
{%- if sameAs.length %}{% set person = person | setAttribute("sameAs", sameAs) %}{% endif -%}
{%- if author.headshot and author.headshot.src %}{% set person = person | setAttribute("image", author.headshot.src | absoluteUrl(site.url)) %}{% endif -%}
{%- set items = [] -%}
{%- for b in books %}{% set items = (items.push({ "@type": "ListItem", "position": loop.index, "name": b.title, "url": ("/books/" + b.slug + ".html") | absoluteUrl(site.url) }), items) %}{% endfor -%}
  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@graph": [
      person,
      {
        "@type": "WebSite",
        "@id": (site.url + "/#website"),
        "url": ("/" | absoluteUrl(site.url)),
        "name": site.name,
        "description": site.description,
        "inLanguage": site.language,
        "author": { "@id": (site.url + "/#person") },
        "publisher": { "@id": (site.url + "/#person") }
      },
      {
        "@type": "ItemList",
        "@id": (site.url + "/#books"),
        "name": "Books by " + author.name,
        "numberOfItems": items.length,
        "itemListOrder": "https://schema.org/ItemListOrderAscending",
        "itemListElement": items
      }
    ]
  } | dump | safe }}</script>
