{#- BreadcrumbList for non-home pages that do not carry their own (book pages render theirs in jsonld-book.njk).
    Journal posts: Home → Journal → post; everything else: Home → page title. -#}
{%- set crumbs = [{ "@type": "ListItem", "position": 1, "name": "Home", "item": "/" | absoluteUrl(site.url) }] -%}
{%- if page.url.startsWith("/blog/posts/") %}
{%- set crumbs = (crumbs.push({ "@type": "ListItem", "position": 2, "name": site.blog.pageTitle, "item": "/blog/" | absoluteUrl(site.url) }), crumbs) %}
{%- set crumbs = (crumbs.push({ "@type": "ListItem", "position": 3, "name": title, "item": page.url | absoluteUrl(site.url) }), crumbs) %}
{%- elif page.url != "/" %}
{%- set crumbs = (crumbs.push({ "@type": "ListItem", "position": 2, "name": title or site.blog.pageTitle, "item": page.url | absoluteUrl(site.url) }), crumbs) %}
{%- endif %}
  <script type="application/ld+json">{{ { "@context": "https://schema.org", "@type": "BreadcrumbList", "itemListElement": crumbs } | dump | safe }}</script>
