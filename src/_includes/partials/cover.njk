{#- cover(book, opts) → the <picture> markup for a cover. URLs carry ?v=<version> because
    netlify.toml serves /media/covers/* as immutable for a year: bump site.assetVersion (or
    book.cover.version) whenever a cover file changes under the same name.
    opts.eager: true on the book detail page (fetchpriority=high); otherwise lazy.
    opts.priority: overrides the eager fetchpriority — the home band passes "low" so the cover never
      competes with the hero's LCP image (the band always sits below the 100dvh hero).
    opts.alt: override alt text (cards pass "" because the title follows the image).
    opts.small: thumbnails (rails / book cards) — only the 600px 1x files, fetchpriority=low. -#}
{%- macro cover(book, opts = {}) -%}
{%- set base = "/media/covers/" + book.cover.base -%}
{%- set v = "?v=" + (book.cover.version or opts.version or "2026-09-25b") -%}
{%- set alt = opts.alt if opts.alt is defined else book.cover.alt -%}
<picture>
            <source type="image/webp" srcset="{{ base }}.webp{{ v }} 1x{% if not opts.small %}, {{ base }}@2x.webp{{ v }} 2x{% endif %}">
            <img
              src="{{ base }}.jpg{{ v }}"
              srcset="{{ base }}.jpg{{ v }} 1x{% if not opts.small %}, {{ base }}@2x.jpg{{ v }} 2x{% endif %}"
              width="{{ book.cover.width }}" height="{{ book.cover.height }}"
              alt="{{ alt }}"
              loading="{{ 'eager' if opts.eager else 'lazy' }}"
{%- if opts.eager %}
              fetchpriority="{{ opts.priority or 'high' }}"
{%- elif opts.small %}
              fetchpriority="low"
{%- endif %}
              decoding="async"
            >
          </picture>
{%- endmacro -%}
