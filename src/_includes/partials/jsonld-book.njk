{#- Book + BreadcrumbList JSON-LD. Only facts from books.json; optional fields render only when set. -#}
{%- set ld = {
  "@context": "https://schema.org",
  "@type": "Book",
  "name": book.title,
  "image": ("/media/covers/" + book.cover.base + "@2x.jpg") | absoluteUrl(site.url),
  "description": book.tagline,
  "author": { "@type": "Person", "name": site.name },
  "isbn": book.isbn,
  "datePublished": book.year | string,
  "inLanguage": "en",
  "bookFormat": ("https://schema.org/Hardcover" if book.format == "Hardcover" else "https://schema.org/Paperback"),
  "url": page.url | absoluteUrl(site.url),
  "publisher": { "@type": "Organization", "name": site.name }
} -%}
{%- if book.pages %}{% set ld = ld | setAttribute("numberOfPages", book.pages) %}{% endif -%}
{%- if book.publishedAs %}{% set ld = ld | setAttribute("alternateName", book.publishedAs) %}{% endif -%}
{%- if book.series %}{% set ld = ld | setAttribute("isPartOf", { "@type": "BookSeries", "name": book.series.name, "position": book.series.order }) %}{% endif -%}
  <script type="application/ld+json">{{ ld | dump | safe }}</script>
  <script type="application/ld+json">{{ {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    "itemListElement": [
      { "@type": "ListItem", "position": 1, "name": "Home", "item": "/" | absoluteUrl(site.url) },
      { "@type": "ListItem", "position": 2, "name": "Books", "item": "/#books" | absoluteUrl(site.url) },
      { "@type": "ListItem", "position": 3, "name": book.title, "item": page.url | absoluteUrl(site.url) }
    ]
  } | dump | safe }}</script>
